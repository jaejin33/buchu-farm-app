# 이 파일을 .env로 복사해서 값을 채운다 (.env는 Git에 올리지 않는다)
# Supabase 화면 위쪽 "Connect" 또는 Settings > API Keys에서 복사한다
# VITE_로 시작해야 화면 코드(브라우저)에서 읽을 수 있다

# 프로젝트 주소 (https://xxxx.supabase.co)
VITE_SUPABASE_URL=

# Publishable key (sb_publishable_...). 예전 이름은 anon 키. 브라우저에 공개되어도 되는 키다 (RLS가 막아 줌)
# secret key / service_role 키는 절대 여기에 넣지 않는다
VITE_SUPABASE_PUBLISHABLE_KEY=
